<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light" />
    <title><%= title %> - Connexion</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/connexion.css" />
  </head>
  <body>
    <main class="connexion_page">
      <section class="connexion_card" aria-labelledby="auth-title">
        <header class="connexion_header">
          <div class="connexion_logoMark" aria-hidden="true">
            <svg
              viewBox="0 0 64 64"
              class="connexion_logoIcon"
              role="img"
              aria-label="Logo portefeuille"
            >
              <path
                d="M12 20a8 8 0 0 1 8-8h24a8 8 0 0 1 8 8v22a8 8 0 0 1-8 8H20a8 8 0 0 1-8-8V20Z"
                fill="currentColor"
              />
              <path
                d="M26 22h20l-6-7h-13a3 3 0 0 0-3 3v4Z"
                fill="#7eb3ff"
                opacity="0.95"
              />
              <rect
                x="33"
                y="30"
                width="22"
                height="12"
                rx="6"
                fill="#ffffff"
                opacity="0.96"
              />
              <circle cx="43" cy="36" r="3" fill="#2a67f6" />
            </svg>
          </div>
          <h1 id="auth-title">Gestionnaire de Dépenses</h1>
          <p>Connectez-vous à votre compte pour accéder à votre espace.</p>
        </header>

        <form class="connexion_form" action="#" method="post">
          <% if (typeof error !== 'undefined' && error) { %>
          <div class="connexion_errorMessage" role="alert"><%= error %></div>
          <% } %>
          <div class="connexion_fieldGroup">
            <label for="email">Adresse e-mail</label>
            <div class="connexion_inputShell">
              <span class="connexion_inputIcon" aria-hidden="true">
                <svg viewBox="0 0 24 24" class="connexion_svgIcon">
                  <path
                    d="M4 5h16a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2Zm0 2v.25l8 5.25 8-5.25V7H4Zm16 10V10.1l-7.44 4.89a1 1 0 0 1-1.12 0L4 10.1V17h16Z"
                    fill="currentColor"
                  />
                </svg>
              </span>
              <input
                id="email"
                name="email"
                type="email"
                placeholder="exemple@domaine.com"
                autocomplete="email"
              />
            </div>
          </div>

          <div class="connexion_fieldGroup">
            <label for="password">Mot de passe</label>
            <div class="connexion_inputShell connexion_inputShellPassword">
              <span class="connexion_inputIcon" aria-hidden="true">
                <svg viewBox="0 0 24 24" class="connexion_svgIcon">
                  <path
                    d="M17 10V8a5 5 0 0 0-10 0v2H5a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7a2 2 0 0 0-2-2h-2Zm-8 0V8a3 3 0 0 1 6 0v2H9Zm3 4a1.5 1.5 0 0 1 1 2.62V18h-2v-1.38A1.5 1.5 0 0 1 12 14Z"
                    fill="currentColor"
                  />
                </svg>
              </span>
              <input
                id="password"
                name="password"
                type="password"
                placeholder="Votre mot de passe"
                autocomplete="current-password"
              />
              <button
                class="connexion_iconButton"
                type="button"
                aria-label="Afficher le mot de passe"
              >
                <svg viewBox="0 0 24 24" class="connexion_svgIcon">
                  <path
                    d="M2.1 3.51 3.51 2.1l18.39 18.39-1.41 1.41-3.17-3.17A11.7 11.7 0 0 1 12 20C6.5 20 2.08 16.49 1 12c.44-1.78 1.34-3.4 2.61-4.74L2.1 3.51Zm7.08 7.08A3.75 3.75 0 0 0 14.9 16.3l-1.41-1.41a1.75 1.75 0 0 1-2.39-2.39L9.18 10.6Zm3.1-4.09c-.08 0-.16 0-.24.01l-2.03-2.03A9.9 9.9 0 0 1 12 4c5.3 0 9.36 3.1 10.56 8-.5 2.03-1.6 3.84-3.1 5.22l-2.05-2.05A6.7 6.7 0 0 0 19.2 12c-1.08-2.78-3.7-5.5-6.92-5.5Z"
                    fill="currentColor"
                  />
                </svg>
              </button>
            </div>
          </div>

          <div class="connexion_meta">
            <label class="connexion_rememberMe">
              <input type="checkbox" name="remember" checked />
              <span>Se souvenir de moi</span>
            </label>
            <a href="#" class="connexion_forgotLink">Mot de passe oublié ?</a>
          </div>

          <button class="connexion_primaryButton" type="submit">
            <span>Se connecter</span>
            <svg
              viewBox="0 0 24 24"
              class="connexion_arrowIcon"
              aria-hidden="true"
            >
              <path
                d="M13 5l7 7-7 7-1.42-1.42L16.17 13H4v-2h12.17l-4.59-4.58L13 5Z"
                fill="currentColor"
              />
            </svg>
          </button>

          <div class="connexion_divider"><span>Ou</span></div>

          <button class="connexion_googleButton" type="button">
            <svg
              viewBox="0 0 48 48"
              class="connexion_googleIcon"
              aria-hidden="true"
            >
              <path
                fill="#FFC107"
                d="M43.611 20.083H42V20H24v8h11.303C33.655 32.657 29.268 36 24 36c-6.627 0-12-5.373-12-12s5.373-12 12-12c3.059 0 5.842 1.154 7.967 3.038l5.657-5.657C33.021 6.053 28.738 4 24 4 12.954 4 4 12.954 4 24s8.954 20 20 20 20-8.954 20-20c0-1.341-.138-2.65-.389-3.917Z"
              />
              <path
                fill="#FF3D00"
                d="M6.306 14.691l6.571 4.819C14.655 15.108 18.952 12 24 12c3.059 0 5.842 1.154 7.967 3.038l5.657-5.657C33.021 6.053 28.738 4 24 4c-7.201 0-13.44 4.068-16.69 10.691Z"
              />
              <path
                fill="#4CAF50"
                d="M24 44c4.676 0 8.878-1.789 12.093-4.707l-5.58-4.712C28.49 35.45 26.426 36 24 36c-5.248 0-9.618-3.321-11.282-7.946l-6.53 5.04C9.392 40.547 16.056 44 24 44Z"
              />
              <path
                fill="#1976D2"
                d="M43.611 20.083H42V20H24v8h11.303c-1.018 2.883-3.07 5.241-5.79 6.581l.002-.001 5.58 4.712C34.69 37.573 40 32 40 24c0-1.341-.138-2.65-.389-3.917Z"
              />
            </svg>
            <span>Se connecter avec Google</span>
          </button>

          <p class="connexion_signupText">
            Vous n’avez pas encore de compte ?
            <a href="/auth/sign-up">Créer un compte</a>
          </p>
        </form>
      </section>
    </main>
  </body>
</html>
